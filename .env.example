# .env.example
# Copy to .env.local and fill values before running locally.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Supabase service role (server only) — keep secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Generative AI (Gemini) keys and base URL for REST calls
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://api.generativeai.example

# Optional
NEXT_PUBLIC_APP_NAME=SNIPEZ
