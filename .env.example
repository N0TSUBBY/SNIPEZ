# .env.example
# .env.example for SNIPEZ (Next.js + Supabase + Gemini)
# Copy to .env.local and fill values before running.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Supabase service role (server only) — MUST be kept secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini / Generative API key (server)
# If your setup uses OAuth instead of API key, wire up server authentication accordingly.
GEMINI_API_KEY=your_gemini_api_key_here

# Optionally used for logging / environment
NEXT_PUBLIC_APP_NAME=SNIPEZ
